---
import { EXPERIENCES, EXPERIENCES_UNRELATED } from "../../../../const";
import ExperienceCard from "./ExperienceCard.astro";
---

<div class="text-[24px] font-bold text-center mb-20">Tech Industry</div>
<div class="grid grid-cols-3 gap-12 mb-20">
  {EXPERIENCES.map((item) => <ExperienceCard item={item} />)}
</div>
<div class="text-[24px] font-bold text-center mb-20">Other Industries</div>
<div class="grid grid-cols-3 gap-12">
  {EXPERIENCES_UNRELATED.map((item) => <ExperienceCard item={item} />)}
</div>