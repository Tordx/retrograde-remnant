---
import { Image } from "astro:assets";
import Card from "../../../../components/Card.astro";

type Props = {
  item: { role: string; company: string; range: string; image: any };
};

const { item } = Astro.props;
---

<Card>
  <div class="px-6 w-full flex flex-row justify-start items-center gap-6">
    <img
      draggable={false}
      src={item?.image.src}
      alt={item?.company ?? ""}
      height={100}
      class="max-w-[100px] my-8 h-[100px] object-contain drop-shadow-sm"
    />
    <div class="flex flex-col justify-center items-start">
      <span class="text-[18px] text-black font-bold">{item?.role ?? ""}</span>
      <span class="text-[15px] text-gray-700 font-medium"
        >{item?.company ?? ""}</span
      >
      <span class="text-[12px] text-gray-500 font-normal"
        >{item?.range ?? ""}</span
      >
    </div>
  </div>
</Card>
