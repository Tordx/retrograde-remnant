---
import ImageRow from "./ImageRow.astro";
import avatar_3 from "../../assets/avatar_3.png";
import avatar_4 from "../../assets/avatar_4.png";
import avatar_5 from "../../assets/avatar_5.png";
---

<div class="flex flex-col justify-start items-center h-[100vh] mt-12 w-full">
  <ImageRow
    letter={[
      { a: "l", b: "Languages & Scripting" },
      { a: "f", b: "Frameworks & Libraries" },
      { a: "s", b: "Styling & CSS Tools" },
      { a: "u", b: "UI/UX & Design Tools" },
      { a: "db", b: "Databases & Storage" },
      { a: "t", b: "Testing & Debugging Tools" }
    ]}
    image={avatar_4}
    title="A Closer Look at the Technologies I Work With"
  />
</div>
