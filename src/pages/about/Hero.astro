---
import Button from "../../components/Button.astro";
import Container from "../../components/Container.astro";
import ReachOut from "../../components/ReachOut.astro";
import avatar_2 from "../../assets/avatar_2.png";
import Avatars from "../../components/Avatars.astro";
import { IMAGES_ABOUT } from "../../const";
---

<section
  id="hero"
  class="w-full flex flex-col max-w-[1440px] px-12 md:flex-row h-auto"
>
  <div id="dets-container">
    <div id="i-am">
      <span id="span-hi"><strong id="strong-i-am">Roven Kyle Narra</strong></span
      ><br />
    </div>
    <p>
      A Computer Science graduate from Pangasinan State University with 4
      years of hands-on experience—2 years in professional roles and 2 years as
      a freelancer. While I focus on frontend development, I often work across
      the full stack, from building APIs to managing deployments. I enjoy
      turning complex ideas into clean, responsive interfaces and crafting
      seamless user experiences backed by solid engineering.
      <br />
      <br />
      Outside of tech,
      <br />
      I'm a motorcycle and car enthusiast who finds joy in engines, open roads, and
      weekend rides. I also love cooking — whether it’s experimenting with new dishes
      or perfecting comfort food classics, the kitchen is my second creative space.
    </p>
    <Button onClick="openAbout()" label="Hire Me" />
    <span id="span-ways" class="flex">Ways to Reach Me</span>
    <ReachOut />
  </div>

  <div id="logo-container">
    <Avatars images={IMAGES_ABOUT} />
  </div>
</section>

<script is:inline>
  (() => {
    const careers = ["Front-end Developer", "Mobile Developer", "UI Designer"];

    let careerIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    const typingEl = document.getElementById("typing");
    if (!typingEl) return;

    function typeEffect() {
      const fullText = careers[careerIndex];

      // Update charIndex before slicing (fixes the missing-last-character bug)
      if (isDeleting) {
        charIndex = Math.max(0, charIndex - 1);
      } else {
        charIndex = Math.min(fullText.length, charIndex + 1);
      }

      typingEl.textContent = fullText.substring(0, charIndex);

      // Pause when full word typed, then delete
      if (!isDeleting && charIndex === fullText.length) {
        isDeleting = true;
        setTimeout(typeEffect, 1500);
        return;
      }

      // When fully deleted, go to next word
      if (isDeleting && charIndex === 0) {
        isDeleting = false;
        careerIndex = (careerIndex + 1) % careers.length;
      }

      const speed = isDeleting ? 40 : 90;
      setTimeout(typeEffect, speed);
    }

    // start with a small delay so the DOM is ready / it feels natural
    setTimeout(typeEffect, 300);
  })();

  window.openAbout = () => {
    window.location.href = "about";
  };
</script>

<style>
  /* 🔹 Logo container (border + gradient) */
  #logo-container {
    --angle: 0deg; /* starting angle */
    position: relative;
    max-width: 500px;
    max-height: 500px;
    min-width: 500px;
    min-height: 500px;
    background: linear-gradient(var(--angle), skyblue, pink, violet);
    background-size: 300% 300%;
    border-radius: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    box-shadow: 3px 3px 0px #000000;
    animation: gradientShift 8s linear infinite;
  }

  @keyframes gradientShift {
    0% {
      --angle: 0deg;
      background-position: 0% 50%;
    }
    50% {
      --angle: 180deg;
      background-position: 100% 50%;
    }
    100% {
      --angle: 360deg;
      background-position: 0% 50%;
    }
  }

  /* 🔹 Logo image inside */
  #logo {
    object-fit: contain;
    opacity: 0;
    transform: translateY(30px) scale(0.9);
    animation: logoSlideUp 1s ease-out forwards 1s;
  }

  @keyframes logoSlideUp {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Text styles */
  #dets-container {
    opacity: 0;
    transform: translateY(20px);
    animation: textFadeIn 1s ease-out forwards 0.5s;
  }
  #i-am {
    font-size: 3rem;
    margin-top: 0.25em;
    text-align: left;
  }

  @keyframes textFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #span-hi {
    font-size: 2.25rem;
  }

  #span-ways {
    font-size: 1.5rem;
    font-weight: 600;
    color: pink;
    filter: drop-shadow(2px 3px 0px #000000);
  }

  #strong-i-am {
    font-size: 3rem;
  }

  strong {
    font-family: "Outfit", sans-serif;
  }

  /* typing cursor */
  #typing {
    border-right: 2px solid #000;
    padding-right: 4px;
    animation: blink 0.8s infinite;
    font-size: 3rem;
  }

  p {
    font-size: 18px;
    max-width: 75%;
  }

  @keyframes blink {
    0%,
    100% {
      border-color: transparent;
    }
    50% {
      border-color: black;
    }
  }

  @media screen and (max-width: 768px) {
    #container {
      display: flex;
      flex-direction: column;
    }

    #hero {
      display: block;
      padding-top: 10%;
    }

    h1 {
      line-height: 1.5;
    }
  }
</style>
