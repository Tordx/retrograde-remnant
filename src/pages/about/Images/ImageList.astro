---
import ImageRow from "./ImageRow.astro";
import avatar_4 from "../../../assets/avatar_4.png";
---

<div class="flex flex-col justify-start items-center mt-12 w-full">
  <ImageRow
    letter={[
      { a: "l", b: "Languages & Scripting" },
      { a: "f", b: "Frameworks & Libraries" },
      { a: "s", b: "Styling & CSS Tools" },
      { a: "u", b: "UI/UX & Design Tools" },
      { a: "db", b: "Databases & Storage" },
      { a: "t", b: "Testing & Debugging Tools" },
      { a: "h", b: "Domain and Hosting Services"},
      { a: "r", b: "Version Control"},
      { a: "w", b: "Workspace and Communcation (with Webhook Integrations)"},
      { a: "pm", b: "Project Management Tools (with Webhook Integrations)"},
      { a: "p", b: "Payment Integration"}
    ]}
    image={avatar_4}
    title="A Closer Look at the Technologies I Work With"
  />
</div>

