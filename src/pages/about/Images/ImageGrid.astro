---
import { Image } from "astro:assets";

export interface Props {
  letter?: string;
  title?: string;
}

const { letter, title } = Astro.props;

const images = import.meta.glob<{ default: any }>(
  "/src/assets/stacks/*.{png,jpg,jpeg,svg,gif,webp}",
  { eager: true }
);

const imageEntries = Object.entries(images)
  .map(([path, module]) => {
    const fileName = path.split("/").pop() ?? "";
    const src = module.default;

    // Example: "l_git.png" => "git"
    const tooltip =
      fileName
        .split("_")
        .pop() // Get part after "_"
        ?.split(".")[0] ?? ""; // Remove extension

    return { src, alt: fileName, tooltip };
  })
  .filter(({ alt }) => {
    if (letter) return alt.startsWith(`${letter}_`);
    return true;
  });
---

<div style="w-full flex flex-col justify-start items-center my-4">
  {title && <div class="text-[24px] font-bold text-left mb-12">{title}</div>}
  <div class="grid grid-cols-8 gap-10">
    {
      imageEntries.map(({ src, alt, tooltip }) => (
        <div class="relative group">
          <Image
            src={src}
            alt={alt}
            height={100}
            class="max-w-[100px] my-8 h-[100px] w-auto object-contain cursor-pointer drop-shadow-amber-50 drop-shadow-xs"
          />
          <span class="whitespace-nowrap absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block text-xs bg-black text-white px-2 py-1 rounded shadow-lg">
            {tooltip}
          </span>
        </div>
      ))
    }
  </div>
</div>
