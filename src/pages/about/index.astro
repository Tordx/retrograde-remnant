import "../../global.css";
import ImageList from "./Images/ImageList.astro";
import Container from "../../components/Container.astro";
import Hero from "./Hero.astro";
import ScrollDown from "./ScrollDown.astro";
import Experience from "./Experience/index.astro";
import Footer from "../../layouts/Footer.astro";
---

<Layout>
  <Header />
  <Main>
    <Container class="2xl:mx-0 flex-col h-full pt-35 justify-start items-start">
      <Hero />
      <Experience />
      <ImageList />

    <Footer />
    </Container>
    <ScrollDown />
