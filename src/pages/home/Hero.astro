---
import Avatars from "../../components/Avatars.astro";
import Button from "../../components/Button.astro";
import Container from "../../components/Container.astro";
import ReachOut from "../../components/ReachOut.astro";
import { IMAGES } from "../../const";
---

<Container>
  <section id="hero" class="w-full flex flex-col max-w-[1440px] px-12 md:flex-row">
    <div id="dets-container">
      <div id="i-am">
        <span id="span-hi">Hi, <strong id="strong-i-am">I am Roven!</strong></span><br />
        <span id="span-hi">a <strong id="typing" aria-live="polite"></strong></span>
      </div>
      <Button onClick="openAbout()" label="About Me" />
      <p class="text-white">
        I’m a versatile full-stack developer with a strong focus on the frontend. I build responsive web and mobile apps
        using multiple modern frameworks and tools—blending clean UI, smooth interactions, and solid engineering to
        deliver experiences that look great and feel even better.
      </p>
      <p id="span-ways">Ways to Reach Me</p>
      <ReachOut />
    </div>

    <div id="logo-container">
      <Avatars images={IMAGES} />
    </div>
  </section>
</Container>

<script is:inline>
  (() => {
    const careers = ["Front-end Developer", "Mobile Developer", "UI Designer", "Freelance Consultant"];

    let careerIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    const typingEl = document.getElementById("typing");
    if (!typingEl) return;

    function typeEffect() {
      const fullText = careers[careerIndex];

      // Update charIndex before slicing (fixes the missing-last-character bug)
      if (isDeleting) {
        charIndex = Math.max(0, charIndex - 1);
      } else {
        charIndex = Math.min(fullText.length, charIndex + 1);
      }

      typingEl.textContent = fullText.substring(0, charIndex);

      // Pause when full word typed, then delete
      if (!isDeleting && charIndex === fullText.length) {
        isDeleting = true;
        setTimeout(typeEffect, 1500);
        return;
      }

      // When fully deleted, go to next word
      if (isDeleting && charIndex === 0) {
        isDeleting = false;
        careerIndex = (careerIndex + 1) % careers.length;
      }

      const speed = isDeleting ? 40 : 90;
      setTimeout(typeEffect, speed);
    }

    // start with a small delay so the DOM is ready / it feels natural
    setTimeout(typeEffect, 300);
  })();

  window.openAbout = () => {
    window.location.href = "about";
  };
</script>

<style>
  /* 🔹 Logo container (border + gradient) */
  #logo-container {
    --angle: 0deg; /* starting angle */
    position: relative;
    max-width: 500px;
    max-height: 500px;
    min-width: 500px;
    min-height: 500px;
    background: linear-gradient(var(--angle), #E4C412, #E4C412, #E4C412);
    background-size: 300% 300%;
    border-radius: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    box-shadow: 3px 3px 0px #000000;
    animation: gradientShift 8s linear infinite;
  }

  @keyframes gradientShift {
    0% {
      --angle: 0deg;
      background-position: 0% 50%;
    }
    50% {
      --angle: 180deg;
      background-position: 100% 50%;
    }
    100% {
      --angle: 360deg;
      background-position: 0% 50%;
    }
  }

  /* 🔹 Logo image inside */
  #logo {
    object-fit: contain;
    opacity: 0;
    transform: translateY(30px) scale(0.9);
    animation: logoSlideUp 1s ease-out forwards 1s;
  }

  @keyframes logoSlideUp {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Text styles */
  #dets-container {
    opacity: 0;
    transform: translateY(20px);
    animation: textFadeIn 1s ease-out forwards 0.5s;
  }
  #i-am {
    font-size: 3rem;
    margin-top: 0.25em;
    text-align: left;
  }

  @keyframes textFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #span-hi {
    font-size: 2.25rem;
    color: white;
  }

  #span-ways {
    font-size: 1.5rem;
    font-weight: 600;
    color: #f0cb46;
    filter: drop-shadow(2px 3px 0px black);
    margin-top: 20px;
  }

  #strong-i-am {
    font-size: 3rem;
    color: #f0cb46;
  }

  strong {
    font-family: "Outfit", sans-serif;
  }

  /* typing cursor */
  #typing {
    border-right: 2px solid #cca000;
    padding-right: 4px;
    animation: blink 0.8s infinite;
    font-size: 3rem;
    color: #f0cb46;
  }

  p {
    font-size: 18px;
    max-width: 75%;
  }

  @keyframes blink {
    0%,
    100% {
      border-color: transparent;
    }
    50% {
      border-color: #cca000;
    }
  }

  @media screen and (max-width: 768px) {
    #container {
      display: flex;
      flex-direction: column;
    }

    #hero {
      display: block;
      padding-top: 10%;
    }

    h1 {
      line-height: 1.5;
    }
  }
</style>
