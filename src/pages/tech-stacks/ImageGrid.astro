---
import { Image } from "astro:assets";

export interface Props {
  letter?: string;
}

const { letter } = Astro.props;

const images = import.meta.glob<{ default: any }>(
  "/src/assets/stacks/*.{png,jpg,jpeg,svg,gif,webp}",
  { eager: true }
);

const imageEntries = Object.entries(images)
  .map(([path, module]) => {
    const fileName = path.split("/").pop() ?? "";
    const src = module.default;

    // Example: "l_git.png" => "git"
    const tooltip =
      fileName
        .split("_")
        .pop() // Get part after "_"
        ?.split(".")[0] ?? ""; // Remove extension

    return { src, alt: fileName, tooltip };
  })
  .filter(({ alt }) => {
    if (letter) return alt.startsWith(`${letter}_`);
    return true;
  });
---

  <div class="grid grid-cols-5 gap-10">
    {
      imageEntries.map(({ src, alt, tooltip }) => (
        <div class="relative group">
          <Image
            src={src}
            alt={alt}
            height={100}
            class="max-w-[100px] h-[100px] w-auto object-contain drop-shadow-sm cursor-pointer"
          />
          <span class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block text-xs bg-black text-white px-2 py-1 rounded shadow-lg">
            {tooltip}
          </span>
        </div>
      ))
    }
  </div>
