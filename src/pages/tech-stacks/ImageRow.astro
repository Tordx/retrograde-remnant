---
import { map } from "astro:schema";
import ImageGrid from "./ImageGrid.astro";
type Props = {
  letter: string[];
  image?: { src: string };
  title?: string;
};
const { letter, image, title } = Astro.props;
---

<div class="w-full max-w-[1440px] flex flex-col justify-center items-start py-12">
  {title && <div class="text-[32px] font-bold text-left mb-12">{title}</div>}
  <section
    class="w-full flex flex-row justify-between items-center"
  >
    <div class="flex flex-col gap-12">
      {letter?.map((item) => <ImageGrid letter={item} />)}
    </div>
    <img
      class="avatar"
      src={image?.src}
      alt={`Avatar ${image && image?.src + 1}`}
    />
  </section>
</div>
