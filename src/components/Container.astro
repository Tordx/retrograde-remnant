---
import { string } from "astro:schema";
import background from "../assets/background.svg";

type Props = {
  class?: string;
};

const { class: className } = Astro.props;
---

<div id="container" class={`flex justify-center items-center ${className}`}>
  <img
    class="fixed top-0 left-0 w-full h-full -z-1 opacity-80 filter blur-2xl"
    src={background.src}
    alt=""
    fetchpriority="high"
  />
  <slot />
</div>
