<style>
  .bounce {
    animation: bounce 2s infinite ease-in-out;
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(10px); /* how far down it moves */
    }
  }
</style>

<div class="flex justify-center">
  <svg
    class="bounce"
    xmlns="http://www.w3.org/2000/svg"
    width="75"
    height="50"
    viewBox="0 0 24 24"
  >
    <title>Chevron-triple-down SVG Icon</title>
    <path
      fill="pink"
      d="M7.41 14.58L12 19.17l4.59-4.59L18 16l-6 6l-6-6zm0-6L12 13.17l4.59-4.59L18 10l-6 6l-6-6zm0-6L12 7.17l4.59-4.59L18 4l-6 6l-6-6z"
    ></path>
  </svg>
</div>
