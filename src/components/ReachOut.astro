---
import { Icon } from "astro-icon/components";
import { REACH_OUT } from "../const";
---

<div id="icon-container" class="bg-[#000814] text-white">
  {
    REACH_OUT.map((item) => (
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="icon-link"
      >
        <Icon name={item.icon} size={40} />
      </a>
    ))
  }
</div>

<style>
  #icon-container {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 2rem;
    margin-block: 2rem;
  }

  .icon-link {
    text-decoration: none;
    color: inherit;
    display: inline-flex;
    filter: brightness(0) saturate(100%) invert(97%) sepia(1%) saturate(3279%)
      hue-rotate(178deg) brightness(97%) contrast(87%)
      drop-shadow(0px 1px 0px #000000);
    transition: filter 0.3s ease;
  }

  .icon-link:hover {
    scale: 1.2;
    animation: hue-pulse 3s ease-in-out infinite alternate;
  }

  @keyframes hue-pulse {
    from {
      filter: brightness(0) saturate(100%) invert(17%) sepia(22%)
        saturate(4898%) hue-rotate(186deg) brightness(95%) contrast(103%);
    }
    to {
      filter: brightness(0) saturate(100%) invert(81%) sepia(55%) saturate(536%)
        hue-rotate(349deg) brightness(95%) contrast(98%);
    }
  }
</style>
