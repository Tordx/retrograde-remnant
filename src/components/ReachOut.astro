---
import { Icon } from "astro-icon/components";
import { REACH_OUT } from "../const";
---

<style>
  #icon-container {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 2rem;
    margin-block: 2rem;
  }

  .icon-link {
    text-decoration: none;
    color: inherit;
    display: inline-flex;
    filter: brightness(0) saturate(100%) invert(79%) sepia(12%) saturate(1256%)
      hue-rotate(160deg) brightness(99%) contrast(86%)
      drop-shadow(0px 1px 0px #000000);
    transition: filter 0.3s ease;
  }

  .icon-link:hover {
    scale: 1.2;
    animation: hue-pulse 3s ease-in-out infinite alternate;
  }

  @keyframes hue-pulse {
    from {
      filter: brightness(0) saturate(100%) invert(79%) sepia(12%)
        saturate(1256%) hue-rotate(160deg) brightness(99%) contrast(86%)
        drop-shadow(0px 1px 0px #000000); /* skyblue-ish */
    }
    to {
      filter: brightness(0) saturate(100%) invert(93%) sepia(29%)
        saturate(3228%) hue-rotate(320deg) brightness(105%) contrast(115%)
        drop-shadow(0px 1px 0px #000000); /* pink-ish */
    }
  }
</style>

<div id="icon-container">
  {
    REACH_OUT.map((item) => (
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="icon-link"
      >
        <Icon name={item.icon} size={40} />
      </a>
    ))
  }
</div>
